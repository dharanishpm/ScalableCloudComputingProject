import json
import time
import random
import boto3
import pandas as pd
from datetime import datetime
import os
from botocore.exceptions import ClientError
from dotenv import load_dotenv

# Load environment variables from .env file
load_dotenv()

# Configuration
AWS_REGION = os.environ.get('AWS_REGION', 'us-east-1')
KINESIS_STREAM_NAME = os.environ.get('KINESIS_STREAM_NAME', 'fleet-stream')
CSV_FILE = os.environ.get('CSV_FILE', 'vehicle_data.csv')
SLEEP_INTERVAL = float(os.environ.get('SLEEP_INTERVAL', '1.0'))  # seconds between records

# Initialize Kinesis client
kinesis_client = boto3.client(
    'kinesis',
    region_name=AWS_REGION
)

def generate_health_score(speed, rpm, engine_load):
    """
    Calculate vehicle health score based on telemetry data
    """
    health_score = 100
    
    # Penalize high speed
    if speed > 120:
        health_score -= 20
    elif speed > 100:
        health_score -= 10
    
    # Penalize high RPM
    if rpm > 5000:
        health_score -= 30
    elif rpm > 4000:
        health_score -= 15
    
    # Penalize high engine load
    if engine_load > 90:
        health_score -= 20
    elif engine_load > 75:
        health_score -= 10
    
    return max(health_score, 0)

def create_telemetry_record(row):
    """
    Create a telemetry record from CSV row with enhanced fields
    """
    current_timestamp = int(datetime.now().timestamp())  # FIXED: Use seconds, not milliseconds
    
    # Extract base telemetry data
    vehicle_id = str(row["VehId"])
    speed = float(row["Vehicle Speed[km/h]"])
    rpm = float(row["Engine RPM[RPM]"])
    engine_load = float(row["Absolute Load[%]"])
    
    record = {
        "vehicleId": vehicle_id,
        "trip": int(row["Trip"]),
        "timestamp": current_timestamp,  # Use current timestamp for real-time simulation
        "latitude": float(row["Latitude[deg]"]),
        "longitude": float(row["Longitude[deg]"]),
        "speed": speed,
        "rpm": rpm,
        "maf": float(row["MAF[g/sec]"]),
        "engineLoad": engine_load,
        "healthScore": generate_health_score(speed, rpm, engine_load),
        "eventType": "telemetry",
        "source": "fleet-producer"
    }
    
    return record

def send_to_kinesis(record, stream_name):
    """
    Send record to Kinesis Data Stream
    """
    try:
        response = kinesis_client.put_record(
            StreamName=stream_name,
            Data=json.dumps(record),
            PartitionKey=record["vehicleId"]
        )
        
        return response
        
    except ClientError as e:
        print(f"Error sending record to Kinesis: {e}")
        return None
    except Exception as e:
        print(f"Unexpected error: {e}")
        return None

def main():
    """
    Main function to stream vehicle telemetry data
    """
    try:
        # Load vehicle data
        print(f"Loading vehicle data from {CSV_FILE}...")
        df = pd.read_csv(CSV_FILE)
        print(f"Loaded {len(df)} records for {df['VehId'].nunique()} vehicles")
        
        # Verify Kinesis stream exists
        try:
            response = kinesis_client.describe_stream(StreamName=KINESIS_STREAM_NAME)
            stream_status = response['StreamDescription']['StreamStatus']
            print(f"Kinesis stream '{KINESIS_STREAM_NAME}' status: {stream_status}")
            
            if stream_status != 'ACTIVE':
                print(f"Warning: Stream is not active. Current status: {stream_status}")
        
        except ClientError as e:
            print(f"Error accessing stream '{KINESIS_STREAM_NAME}': {e}")
            return
        
        print(f"Starting data streaming to Kinesis stream: {KINESIS_STREAM_NAME}")
        print(f"Sleep interval: {SLEEP_INTERVAL} seconds")
        print("-" * 50)
        
        records_sent = 0
        errors = 0
        
        # Stream data continuously
        while True:
            for _, row in df.iterrows():
                # Create telemetry record
                record = create_telemetry_record(row)
                
                # Send to Kinesis
                response = send_to_kinesis(record, KINESIS_STREAM_NAME)
                
                if response:
                    records_sent += 1
                    print(f"[{records_sent}] Sent: Vehicle {record['vehicleId']} | "
                          f"Speed: {record['speed']:.1f} km/h | "
                          f"RPM: {record['rpm']:.0f} | "
                          f"Health: {record['healthScore']}")
                    
                    # Log successful response details
                    shard_id = response.get('ShardId', 'Unknown')
                    sequence_number = response.get('SequenceNumber', 'Unknown')
                    print(f"    → Shard: {shard_id} | Sequence: {sequence_number[:10]}...")
                    
                else:
                    errors += 1
                    print(f"[ERROR {errors}] Failed to send record for vehicle {record['vehicleId']}")
                
                # Sleep between records
                time.sleep(SLEEP_INTERVAL)
        
    except FileNotFoundError:
        print(f"Error: CSV file '{CSV_FILE}' not found")
        print("Please ensure the vehicle data CSV file exists")
        
    except KeyboardInterrupt:
        print(f"\nStreaming stopped by user")
        print(f"Summary: {records_sent} records sent, {errors} errors")
        
    except Exception as e:
        print(f"Unexpected error: {e}")

if __name__ == "__main__":
    main()
