def generate_health_score(speed, rpm, engine_load):
    """
    Calculate vehicle health score based on telemetry data
    """
    health_score = 100
    
    # Penalize high speed
    if speed > 120:
        health_score -= 20
    elif speed > 100:
        health_score -= 10
    
    # Penalize high RPM
    if rpm > 5000:
        health_score -= 30
    elif rpm > 4000:
        health_score -= 15
    
    # Penalize high engine load
    if engine_load > 90:
        health_score -= 20
    elif engine_load > 75:
        health_score -= 10
    
    return max(health_score, 0)

def create_telemetry_record(row):
    """
    Create a telemetry record from CSV row with enhanced fields
    """
    current_timestamp = int(datetime.now().timestamp())  # FIXED: Use seconds, not milliseconds
    
    # Extract base telemetry data
    vehicle_id = str(row["VehId"])
    speed = float(row["Vehicle Speed[km/h]"])
    rpm = float(row["Engine RPM[RPM]"])
    engine_load = float(row["Absolute Load[%]"])
    
    record = {
        "vehicleId": vehicle_id,
        "trip": int(row["Trip"]),
        "timestamp": current_timestamp,  # Use current timestamp for real-time simulation
        "latitude": float(row["Latitude[deg]"]),
        "longitude": float(row["Longitude[deg]"]),
        "speed": speed,
        "rpm": rpm,
        "maf": float(row["MAF[g/sec]"]),
        "engineLoad": engine_load,
        "healthScore": generate_health_score(speed, rpm, engine_load),
        "eventType": "telemetry",
        "source": "fleet-producer"
    }
    
    return record
    